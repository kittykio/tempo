# backend/.env loads automatically. Hosting environment variables take precedence.
# Set DATABASE_URL for Neon/PostgreSQL. Leave unset to use local SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
# Local development defaults work without any of these settings.
# TEMPO_DB=/absolute/path/tempo.db

# Required when deployed over HTTPS (replace the example host).
TEMPO_COOKIE_SECURE=true
TEMPO_PUBLIC_URL=https://tempo.example.com
TEMPO_ALLOWED_ORIGINS=https://tempo.example.com

# Password reset email uses SMTP with STARTTLS. Do not commit real credentials.
TEMPO_SMTP_HOST=smtp.resend.com
TEMPO_SMTP_PORT=587
TEMPO_SMTP_USER=resend
# Set to your Resend API key in Vercel or the ignored backend/.env.
TEMPO_SMTP_PASSWORD=
TEMPO_MAIL_FROM='Kitty Kio <noreply@kittykio.com>'
